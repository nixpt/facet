// demo/env_greet.crush — env fallback via the facet-env companion.
//
// facet_env.crush uses facet internals (__facet_*), which cannot be imported,
// so this demo concatenates facet.crush AND facet_env.crush. Run from the
// facet repo root. The --env grant goes BEFORE `--`, and is needed even for
// --help, because the capability check covers the whole program:
//   cat facet.crush facet_env.crush demo/env_greet.crush > /tmp/env_greet.crush
//   GREET_LEVEL=3 crush-run run --env /tmp/env_greet.crush -- --name Ada
//   crush-run run --env /tmp/env_greet.crush -- --help
// With GREET_LEVEL=3 the --level option's env fallback applies when argv
// leaves it unset.

fn main() {
    let spec = { name: "env-greet", options: [ { long: "--level", short: "-l", type: "int", default: 1, env: "GREET_LEVEL", help: "verbosity (env: GREET_LEVEL)" }, { long: "--name", type: "str", required: true } ] }
    let args = facet_parse(spec)
    facet_env_apply(spec, args)
    io.print("level=" + conv.to_str(args.level) + " name=" + args.name)
}
