// examples/demo/env_greet.crush — env fallback via the facet_env companion (import form).
//
// facet_env imports facet itself and is import-only. Run from the facet repo
// root. The --env grant goes BEFORE `--`, and is needed even for --help,
// because the capability check covers the whole program:
//   GREET_LEVEL=3 crush-run run -L . --env examples/demo/env_greet.crush -- --name Ada
//   crush-run run -L . --env examples/demo/env_greet.crush -- --help
// With GREET_LEVEL=3 the --level option's env fallback applies when argv
// leaves it unset.

import facet { facet_parse }
import facet_env { facet_env_apply }

fn main() {
    let spec = { name: "env-greet", options: [ { long: "--level", short: "-l", type: "int", default: 1, env: "GREET_LEVEL", help: "verbosity (env: GREET_LEVEL)" }, { long: "--name", type: "str", required: true } ] }
    let args = facet_parse(spec)
    facet_env_apply(spec, args)
    io.print("level=" + conv.to_str(args.level) + " name=" + args.name)
}
